{
  "$schema": "https://json-schema.org",
  "title": "WorkflowSchema",
  "type": "object",
  "properties": {
    "wf-id": {
      "type": "string",
      "description": "Identificador do workflow."
    },
    "wf-title": {
      "type": "string",
      "description": "Título do workflow."
    },
    "wf-version": {
      "type": "string",
      "description": "Versão do workflow."
    },
    "wf-language": {
      "type": "string",
      "description": "Idioma do workflow."
    },
    "wf-owner": {
      "type": "string",
      "description": "Proprietário do workflow."
    },
    "wf-responsible": {
      "type": "string",
      "description": "Responsável pelo Workflow."
    },
    "wf-description": {
      "type": "string",
      "description": "Descrição do workflow."
    },
    "wf-creation-date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de criação do workflow."
    },
    "wf-last-modification-date": {
      "type": "string",
      "format": "date-time",
      "description": "Data da última modificação do workflow."
    },
    "wf-last-modification-author": {
      "type": "string",
      "description": "Autor da última modificação do workflow."
    },
    "wf-status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ],
      "description": "Status do workflow."
    },
    "wf-policies": {
      "type": "object",
      "description": "Políticas do workflow.",
      "properties": {
        "mandatory_security_for_code_changes": {
          "type": "boolean",
          "description": "Indica se a segurança é obrigatória para alterações de código."
        },
        "user_decision_channel": {
          "type": "string",
          "enum": [
            "Responsável pelo Workflow",
            "Outro Canal"
          ],
          "description": "Canal de decisão do usuário."
        },
        "only_orchestrator_may_escalate_to_user": {
          "type": "boolean",
          "description": "Indica se apenas o orquestrador pode escalar para o usuário."
        },
        "agents_must_always_return_operational_output": {
          "type": "boolean",
          "description": "Indica se os agentes devem sempre retornar saída operacional."
        },
        "no_silent_stops": {
          "type": "boolean",
          "description": "Indica se não há paradas silenciosas."
        }
      },
      "required": [
        "mandatory_security_for_code_changes",
        "user_decision_channel",
        "only_orchestrator_may_escalate_to_user",
        "agents_must_always_return_operational_output",
        "no_silent_stops"
      ]
    },
    "wf-agents": {
      "type": "array",
      "description": "Lista de agentes configurados no workflow.",
      "items": {
        "type": "object",
        "properties": {
          "ag-id": {
            "type": "string",
            "description": "Identificador único do agente (ex: orchestrator)."
          },
          "ag-name": {
            "type": "string",
            "description": "Nome amigável ou exibível do agente."
          },
          "ag-skills": {
            "type": "array",
            "description": "Lista de caminhos para os arquivos markdown de skills que o agente pode executar.",
            "items": {
              "type": "string"
            }
          },
          "ag-input": {
            "type": "string",
            "description": "Dados ou informações de entrada para o agente."
          },
          "ag-processing": {
            "type": "string",
            "description": "Dados ou informações de processamento para o agente."
          },
          "ag-output": {
            "type": "string",
            "description": "Dados ou informações de saída para o agente."
          },
          "ag-events": {
            "type": "array",
            "description": "Lista de eventos que o agente pode emitir.",
            "items": {
              "type": "object",
              "properties": {
                "ev-id": {
                  "type": "string",
                  "description": "Identificador único do evento."
                },
                "ev-name": {
                  "type": "string",
                  "description": "Nome do evento."
                },
                "ev-description": {
                  "type": "string",
                  "description": "Descrição do evento."
                }
              }
            }
          }
        },
        "required": [
          "ag-id",
          "ag-name",
          "ag-skills",
          "ag-input",
          "ag-processing",
          "ag-output"
        ]
      }
    }
  },
  "required": [
    "wf-id",
    "wf-title",
    "wf-version",
    "wf-language",
    "wf-owner",
    "wf-responsible",
    "wf-description",
    "wf-creation-date",
    "wf-last-modification-date",
    "wf-last-modification-author",
    "wf-status",
    "wf-policies",
    "wf-agents"
  ]
}